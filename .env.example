# Environment Configuration for ReserveEase Appointment Booking System

# Port for the Full-Stack Server
PORT=3000

# MongoDB Connection String (leave blank or empty to use automatic embedded MongoMemoryServer for zero-config local run)
# Example local MongoDB: mongodb://localhost:27017/appointment_booking
# Example MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/appointment_booking?retryWrites=true&w=majority
MONGODB_URI=""

# JWT Secret for signing authentication tokens
JWT_SECRET="super-secret-reserve-ease-jwt-token-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# Client Base API URL (defaults to /api for relative calls when hosted together)
VITE_API_URL="/api"
